# ─── Mizan AI — Environment template. Copy to .env and fill. ────────────────
GROQ_API_KEY=gsk_your_groq_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Security — generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change_me_to_a_long_random_hex
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=14

# Bootstrap admin (created automatically on first start if no admin exists)
ADMIN_EMAIL=admin@mizan.ly
ADMIN_PASSWORD=change_me_strong_password

# Server
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:4173,http://localhost:3000
